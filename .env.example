# Copy to .env, then run `docker compose up`.

# Required. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# The URL people open in the browser. Change it when you host on a domain.
BETTER_AUTH_URL=http://localhost:3001

# Picks the moments worth clipping. Any OpenAI-compatible Chat Completions API works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
# For Ollama running on the host instead, use a model with a large context window:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b
# LLM_MAX_TRANSCRIPT_CHARS=20000

# Optional
# WEB_PORT=3001
# POSTGRES_PASSWORD=password
# POSTGRES_PORT=5432
# MAX_UPLOAD_MB=4096
# WHISPER_MODEL=small
# WHISPER_THREADS=4
# WHISPER_TIMEOUT_MINUTES=120
