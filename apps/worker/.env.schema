# @defaultRequired=true
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @sensitive @type=string(minLength=1)
DATABASE_URL=

# Media volume shared with web. Compose sets /data.
DATA_DIR=../../.data

# @type=url
WHISPER_URL=http://localhost:8000

# Minutes to wait for one transcription. CPU Whisper on a long video is slow.
# @type=number(min=1)
WHISPER_TIMEOUT_MINUTES=120

# Any OpenAI-compatible Chat Completions base URL, ending before /chat/completions.
# For Ollama on the host use http://host.docker.internal:11434/v1
# @type=url
LLM_BASE_URL=https://api.openai.com/v1

# Leave empty for servers that need no key, such as Ollama.
# @sensitive @required=false
LLM_API_KEY=

LLM_MODEL=gpt-5.4-mini

# Transcript characters per LLM request. Longer transcripts are split into
# overlapping windows. Lower it for local models with small context windows.
# @type=number(min=4000)
LLM_MAX_TRANSCRIPT_CHARS=60000
