# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Media folder shared with the worker. Uploads land in sources/, the worker
# writes clips/. Compose sets /data. The dev default resolves from apps/web to
# the repo's .data folder. Not @public: public values are fixed at build time.
DATA_DIR=../../.data

# Largest accepted upload, in megabytes.
# @type=number(min=1)
MAX_UPLOAD_MB=4096
